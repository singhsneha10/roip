{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "com.roip.events",
  "fields": [
    {"name": "event_id",      "type": "string"},
    {"name": "event_type",    "type": {"type": "enum", "name": "EventType",
      "symbols": ["ORDER_PLACED","ORDER_CONFIRMED","ORDER_CANCELLED",
                  "PAYMENT_INITIATED","PAYMENT_SUCCESS","PAYMENT_FAILED",
                  "ORDER_SHIPPED","ORDER_DELIVERED"]}},
    {"name": "order_id",      "type": "string"},
    {"name": "customer_id",   "type": "string"},
    {"name": "occurred_at",   "type": "long",   "logicalType": "timestamp-millis"},
    {"name": "ingested_at",   "type": "long",   "logicalType": "timestamp-millis"},
    {"name": "schema_version","type": "string", "default": "1.0"},
    {"name": "source_system", "type": "string", "default": "order-service"},
    {"name": "payload",       "type": {"type": "map", "values": "string"}}
  ]
}